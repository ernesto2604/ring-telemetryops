# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C environments
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets (CRITICAL: never commit AWS or Ring credentials)
.env
.env.*
!.env.example
# OAuth token cache of the removed unofficial Ring adapter: never commit it if one still exists
.ring_token.cache
*.token.cache

# IDEs & Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Temporary analysis frames / generated evidence / user uploads
data/temp/
data/frames/
data/uploads/
data/feedback/
*.jpg
*.jpeg
*.png
!assets/*.png
!assets/*.jpg

# Large video sample files (ignore heavy videos except core base samples)
data/samples/*.mp4
!data/samples/good_internet.mp4
!data/samples/bad_internet.mp4
!data/samples/optical_obstruction.mp4
# Local diagnostic dumps (e.g. a saved `git diff` output); never part of the project
qqcl

# Outputs of the live Bedrock verification (may quote model answers; never commit)
live_verification/
