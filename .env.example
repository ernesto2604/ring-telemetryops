AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
# Only for temporary credentials (access key IDs starting with ASIA, e.g. SSO / STS / lab accounts).
# Long-term keys (AKIA...) do not need it. Used only when it is set and both keys above are set.
# AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Ring data source: simulator (default) | partner
#   simulator -> Digital Twin only; no Ring connection is attempted.
#   partner   -> Official Ring Partner API (requires RING_PARTNER_ACCESS_TOKEN).
# Setting credentials alone never switches the source. Any other value is an explicit error.
# A RING_DATA_SOURCE set in the shell wins over this file; restart the server after editing it.
RING_DATA_SOURCE=simulator

# Ring Partner API (used only when RING_DATA_SOURCE=partner).
# Obtain these from the Ring Developer Partner application after OAuth linking.
# RING_PARTNER_DEVICE_ID selects the default device for telemetry and analysis.
#
# Partner monitoring (polling of GET /v1/devices/{device_id}/status; webhooks are not implemented).
# These are prototype design defaults, NOT Ring recommendations: Ring documents no polling interval.
#   RING_PARTNER_POLL_SECONDS         seconds between status reads (5-3600, default 15)
#   RING_PARTNER_OFFLINE_ALERT_READS  online=false reads in a row (no online=true between them) that
#                                     confirm an offline alert (1-100, default 3)
#   RING_PARTNER_OFFLINE_ALERT_MAX_GAP_SECONDS
#                                     max seconds between two reads where Ring reported online true/false;
#                                     a longer gap (API errors, online=null, rate limiting) discards the
#                                     streak (poll interval-86400, default 4 x poll interval)
# HTTP 429 without Retry-After pauses polling with exponential backoff (1 s doubling, 300 s cap);
# Retry-After is always honoured. API errors never mark the device offline.
RING_PARTNER_POLL_SECONDS=15
RING_PARTNER_OFFLINE_ALERT_READS=3
RING_PARTNER_OFFLINE_ALERT_MAX_GAP_SECONDS=60
RING_PARTNER_ACCESS_TOKEN=
RING_PARTNER_DEVICE_ID=
# Optional. Every Ring request sends User-Agent: RingTelemetryOps/<version> and a Hardware_Id UUID.
# RING_PARTNER_HARDWARE_ID overrides that UUID; by default it is derived (UUID5) from this computer's
# name and RING_PARTNER_DEVICE_ID, so it does not change between runs.
# RING_PARTNER_BASE_URL overrides the Ring API host (default https://api.amazonvision.com); tests use it
# to point the client at a local fake server.
# RING_PARTNER_HARDWARE_ID=
# RING_PARTNER_BASE_URL=https://api.amazonvision.com
